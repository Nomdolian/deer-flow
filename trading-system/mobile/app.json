{
  "expo": {
    "name": "Trading System",
    "slug": "trading-system-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "tradingsystem",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4C9FFE"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.tradingsystem.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Used to alert you about new signals, fills, kill switch events, and feed health issues."
      }
    },
    "android": {
      "package": "com.tradingsystem.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["NOTIFICATIONS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
