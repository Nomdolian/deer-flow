# Copy to .env and fill in. NEVER commit the real .env file.
# In production, inject these via a secrets manager (Vault, AWS Secrets Manager,
# systemd credentials, etc.) — not a plain .env file on the always-on server.

# --- Database ---
DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/trading

# --- Kill switch / risk defaults ---
RISK_PER_TRADE_PCT=0.0025
PORTFOLIO_RISK_CAP_PCT=0.03
CORRELATION_GROUP_RISK_CAP_PCT=0.015
MEME_BUCKET_CAP_PCT=0.05
DAILY_LOSS_LIMIT_PCT=0.03
WEEKLY_LOSS_LIMIT_PCT=0.06
CONSECUTIVE_LOSS_BREAKER=4
FEED_STALE_SECONDS=60

# --- Broker credentials: TRADE-ONLY SCOPED KEYS. Withdrawal/transfer permissions
# must be disabled at the broker/exchange level. Never grant more than trading needs. ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# --- Market data: Alpha Vantage (free tier gives daily OHLCV for FX/equities/
# crypto; intraday endpoints require a paid Alpha Vantage plan — see
# app/data/providers/alpha_vantage_provider.py). Get a key at
# https://www.alphavantage.co/support/#api-key ---
ALPHA_VANTAGE_API_KEY=

# --- LLM analyst layer (never on the execution path) ---
ANTHROPIC_API_KEY=

# --- API auth (Phase 8 client apps) ---
API_AUTH_SECRET=change-me-to-a-long-random-value
API_TOTP_SECRET=

ENV=development
